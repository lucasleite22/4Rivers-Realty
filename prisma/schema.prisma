// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  AGENT
}

enum PropertyType {
  HORSE_FARM
  RANCH
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum PropertyStatus {
  ACTIVE
  SOLD
  UNDER_CONTRACT
}

enum PropertySource {
  AGENT
  MLS
  CLIENT
}

enum LeadType {
  BUYER
  SELLER
  INVESTOR
}

enum LeadOrigin {
  WEBSITE
  REFERRAL
  ZILLOW
  REALTOR_COM
  INSTAGRAM
  OTHER
}

enum LeadStatus {
  NEW_LEAD
  CONTACTED
  SHOWING
  OFFER_MADE
  UNDER_CONTRACT
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  CALL
  EMAIL
  SHOWING
  OFFER
  NOTE
}

enum DashboardEventType {
  PROPERTY_CREATED
  PROPERTY_SOLD
  LEAD_CREATED
  LEAD_STAGE_CHANGED
  SHOWING_SCHEDULED
  OFFER_MADE
  DEAL_CLOSED
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(AGENT)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads      Lead[]         @relation("AssignedLeads")
  activities LeadActivity[]

  @@index([email])
  @@map("users")
}

model Property {
  id                   String         @id @default(cuid())
  title                String
  type                 PropertyType
  priceUsd             Decimal        @db.Decimal(15, 2)
  acreage              Decimal        @db.Decimal(10, 2)
  county               String
  city                 String
  address              String
  description          String         @db.Text
  status               PropertyStatus @default(ACTIVE)
  source               PropertySource @default(AGENT)
  featured             Boolean        @default(true)
  showOnPortal         Boolean        @default(true)
  stables              Int?
  arenas               Int?
  pastures             Int?
  videoUrl             String?
  isLaunch             Boolean        @default(false)
  launchBadge          String?
  launchDate           DateTime?
  // Geolocation — populated by Google Maps Geocoding API (Semana 6, Luan)
  latitude             Float?
  longitude            Float?
  // MLS sync — populated by services/mlsgrid.service.ts sync job (Semana 8, Luan)
  mlsId                String?        @unique
  bedrooms             Int?
  bathrooms            Int?
  sqft                 Int?
  yearBuilt            Int?
  mlsStatus            String? // raw StandardStatus from the MLS feed (e.g. 'Active', 'Pending') — distinct from PropertyStatus above
  // Required MLS compliance attribution — listing office/agent of record, shown on public pages for source: MLS
  mlsListOfficeName    String?
  mlsListAgentFullName String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  images PropertyImage[]

  @@index([type])
  @@index([status])
  @@index([county])
  @@index([featured])
  @@index([showOnPortal])
  @@index([isLaunch])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  isCover    Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

model Lead {
  id               String     @id @default(cuid())
  name             String
  email            String?
  phone            String?
  type             LeadType
  origin           LeadOrigin
  propertyInterest String?
  budgetUsd        Decimal?   @db.Decimal(15, 2)
  acreageDesired   Decimal?   @db.Decimal(10, 2)
  countyPreferred  String?
  status           LeadStatus @default(NEW_LEAD)
  notes            String?    @db.Text
  assignedToId     String?
  lastContactAt    DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  assignedTo User?          @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities LeadActivity[]

  @@index([status])
  @@index([type])
  @@index([assignedToId])
  @@index([lastContactAt])
  @@map("leads")
}

model LeadActivity {
  id           String       @id @default(cuid())
  leadId       String
  userId       String?
  type         ActivityType
  notes        String?      @db.Text
  activityDate DateTime
  createdAt    DateTime     @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@map("lead_activities")
}

// Tracks the delta-sync cursor for the MLSGrid replication feed — one row
// per OriginatingSystemName, so the sync job knows where it left off.
model MlsSyncState {
  id                        String   @id @default(cuid())
  originatingSystemName     String   @unique // e.g. 'mfrmls'
  lastModificationTimestamp DateTime
  lastRunAt                 DateTime @default(now())
  lastRunStatus             String? // 'success' | 'error'
  lastRunError              String?  @db.Text
  updatedAt                 DateTime @updatedAt

  @@map("mls_sync_state")
}

// Analytical copy of MLS listings for the RealRisk dashboard (investment
// scoring) — NOT portal inventory. Data only: no photos, no curation queue.
// Filled by upsertMlsListing() in lib/mls-sync.ts for REALRISK_COUNTIES.
// Same MLS Grid compliance as Property: MlgCanView false → row is deleted.
model MlsListing {
  listingKey            String    @id // ListingKey
  listingId             String // MLS # shown to users
  standardStatus        String // Active | Pending | Active Under Contract | Closed | ...
  propertyType          String
  propertySubType       String?
  listPrice             Decimal?  @db.Decimal(15, 2)
  originalListPrice     Decimal?  @db.Decimal(15, 2)
  closePrice            Decimal?  @db.Decimal(15, 2)
  closeDate             DateTime?
  listingContractDate   DateTime?
  daysOnMarket          Int?
  address               String?
  city                  String?
  county                String?
  postalCode            String?
  latitude              Float?
  longitude             Float?
  bedrooms              Int?
  bathrooms             Int?
  livingArea            Int?
  lotSizeAcres          Decimal?  @db.Decimal(12, 4)
  yearBuilt             Int?
  hoaMonthly            Decimal?  @db.Decimal(10, 2)
  taxAnnual             Decimal?  @db.Decimal(12, 2)
  taxYear               Int?
  poolPrivate           Boolean?
  zoning                String?
  floodZone             String? // MFR_FloodZoneCode
  leaseRestrictions     Boolean? // MFR_LeaseRestrictionsYN — HOA lease rules, NOT zoning
  minimumLease          String? // MFR_MinimumLease ("No Minimum", "1 Month", ...)
  waterSource           String? // WaterSource joined (Public, Well, ...)
  sewer                 String? // Sewer joined (Septic Tank, Public Sewer, ...)
  utilities             String?   @db.Text // Utilities joined
  lotFeatures           String?   @db.Text // LotFeatures joined (Paved, Pasture, In County, ...)
  publicRemarks         String?   @db.Text
  listOfficeName        String?
  listAgentFullName     String?
  mlgCanUse             String? // e.g. "IDX,VOW"
  modificationTimestamp DateTime
  firstSeenAt           DateTime  @default(now()) // "new listing" from our point of view
  updatedAt             DateTime  @updatedAt

  @@index([county])
  @@index([standardStatus])
  @@index([firstSeenAt])
  @@index([listingContractDate])
  @@map("mls_listings")
}

model DashboardEvent {
  id         String             @id @default(cuid())
  type       DashboardEventType
  entityId   String
  entityType String
  metadata   Json?
  userId     String?
  createdAt  DateTime           @default(now())

  @@index([type])
  @@index([createdAt])
  @@map("dashboard_events")
}
